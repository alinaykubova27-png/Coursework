    arr = arr.astype(np.float32) / 255.0
    arr = np.expand_dims(arr, axis=0)
    preds = keras_model.predict(arr, verbose=False)[0]
    top3 = np.argsort(preds)[::-1][:3]
    
    print('MobileNetV2:')
    for i, idx in enumerate(top3):
        bar = '#' * int(preds[idx] * 30)
        print(f'  {i+1}. {class_names[idx]:<30} {preds[idx]*100:5.1f}%  {bar}')
        
    # YOLOv8
    res = yolo_model.predict('/tmp/demo_tree.jpg', verbose=False)[0]
    print('YOLOv8n-cls:')
    for i, (idx, conf) in enumerate(zip(res.probs.top5[:3], res.probs.top5conf[:3].tolist())):
        bar = '#' * int(conf * 30)
        print(f'  {i+1}. {res.names[idx]:<30} {conf*100:5.1f}%  {bar}')
